---
# =============================================================================
# vars/secrets.yml  — Ansible Vault Secrets
# =============================================================================
# NEVER commit this file unencrypted.
#
# Setup:
#   cp vars/secrets.yml.template vars/secrets.yml
#   # Edit vars/secrets.yml with real values, then:
#   ansible-vault encrypt vars/secrets.yml
#
# To edit after encryption:
#   ansible-vault edit vars/secrets.yml
#
# Run playbook with vault:
#   ansible-playbook fedora-do.yml --ask-become-pass --ask-vault-pass
# =============================================================================

# ── SMB Credentials ───────────────────────────────────────────────────────────
# Keys must match the 'cred_key' values in vars/smb.yml.
smb_credentials:
  nas_primary:
    username: "your_nas_username"
    password: "your_nas_password"
  nas_docs:
    username: "your_docs_username"
    password: "your_docs_password"
