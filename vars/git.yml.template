---
# =============================================================================
# vars/git.yml — Git Global Configuration
# =============================================================================
# This file is NOT committed to the repository (see .gitignore).
#
# Setup:
#   cp vars/git.yml.template vars/git.yml
#   # Edit vars/git.yml with your real name and email.
#
# Leave values blank ("") to skip setting name/email — all other Git
# defaults (default branch, pull strategy, credential helper) still apply.
# =============================================================================

git_user_name: "Your Name"
git_user_email: "you@example.com"
