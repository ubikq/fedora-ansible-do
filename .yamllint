---
extends: default
rules:
  # Required overrides for ansible-lint compatibility
  document-start: disable  # vault-encrypted files cannot start with ---
  comments:
    min-spaces-from-content: 1  # ansible-lint requires 1, default is 2
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  # Project style: allow alignment spacing
  colons:
    max-spaces-after: -1
  commas:
    max-spaces-after: -1
  line-length:
    max: 160
    allow-non-breakable-words: true
    allow-non-breakable-inline-mappings: true
